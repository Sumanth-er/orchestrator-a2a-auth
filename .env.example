# Keycloak
KC_URL=http://localhost:8080
KC_REALM=a2a-demo
KC_ISSUER=http://localhost:8080/realms/a2a-demo

# UI client (public, PKCE)
KC_UI_CLIENT_ID=a2a-ui

# Orchestrator (confidential)
# Secret below matches keycloak/realm-export.json. Change in both places if you regenerate.
KC_ORCHESTRATOR_CLIENT_ID=orchestrator
KC_ORCHESTRATOR_CLIENT_SECRET=orchestrator-demo-secret-9f2x4a8b

# Agents (each confidential)
KC_WEATHER_CLIENT_ID=weather-agent
KC_WEATHER_CLIENT_SECRET=weather-demo-secret-3k7m1q5z
KC_BILLING_CLIENT_ID=billing-agent
KC_BILLING_CLIENT_SECRET=billing-demo-secret-6p4n8w2c

# LLM (Ollama via langchain-ollama)
# Make sure Ollama is running locally: `ollama serve` and `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Ports
ORCHESTRATOR_PORT=3000
WEATHER_AGENT_PORT=9101
BILLING_AGENT_PORT=9102
